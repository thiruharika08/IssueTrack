# ============================================
# BugTracker Pro — Git Ignore
# ============================================

# Dependencies
node_modules/
*/node_modules/

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
backend/.env
frontend/.env

# Build output
frontend/dist/
frontend/build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# Uploads (keep directory, ignore files)
backend/uploads/*
!backend/uploads/.gitkeep

# Coverage
coverage/
*.lcov

# Temporary files
*.tmp
*.temp
.cache/
