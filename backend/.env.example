# ============================================
# BugTracker Pro — Backend Environment
# ============================================

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas for production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/bugtracker-pro?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=change_this_to_a_random_64_char_string_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
